from rest_framework import viewsets, status
from rest_framework.decorators import action
from rest_framework.response import Response
from .models import Headquarters, SoporteDocumental, TipoDocumentoSoporte
from .serializers import HeadquartersSerializer, SoporteDocumentalSerializer

class SoporteDocumentalViewSet(viewsets.ModelViewSet):
    queryset = SoporteDocumental.objects.all()
    serializer_class = SoporteDocumentalSerializer

    def perform_create(self, serializer):
        """
        Lógica para el manejo de versiones: Al cargar un nuevo soporte, 
        los anteriores del mismo tipo para esa sede pasan a ser no vigentes.
        """
        sede = serializer.validated_data.get('sede')
        tipo = serializer.validated_data.get('tipo_documento')
        
        # Desactivar versiones anteriores
        SoporteDocumental.objects.filter(
            sede=sede, tipo_documento=tipo, es_vigente=True
        ).update(es_vigente=False)
        
        # Calcular nueva versión
        ultima_version = SoporteDocumental.objects.filter(
            sede=sede, tipo_documento=tipo
        ).count()
        
        serializer.save(version=ultima_version + 1, es_vigente=True)

    @action(detail=False, methods=['get'], url_path='historial/(?P<sede_id>[^/.]+)/(?P<tipo_id>[^/.]+)')
    def historial(self, request, sede_id=None, tipo_id=None):
        """Endpoint para ver todas las versiones de un soporte específico de una sede."""
        historico = SoporteDocumental.objects.filter(
            sede_id=sede_id, tipo_documento_id=tipo_id
        ).order_by('-fecha_carga')
        serializer = self.get_serializer(historico, many=True)
        return Response(serializer.data)

class HeadquartersViewSet(viewsets.ModelViewSet):
    queryset = Headquarters.objects.all()
    serializer_class = HeadquartersSerializer