from django.contrib import admin
from .models import Headquarters, DatosSede, SoporteDocumental, TipoDocumentoSoporte

@admin.register(Headquarters)
class HeadquartersAdmin(admin.ModelAdmin):
    list_display = ('name', 'city', 'status', 'concepto_sanitario', 'updateDate')
    list_filter = ('status', 'department', 'concepto_sanitario')
    search_fields = ('name', 'habilitationCode')
    # Organización por Estándares de la Res. 3100
    fieldsets = (
        ('Identificación', {'fields': ('name', 'company', 'address', 'city')}),
        ('Infraestructura (Res. 465/2025)', {'fields': ('licencia_construccion', 'estudio_vulnerabilidad', 'concepto_sanitario')}),
        ('Soportes Críticos', {'fields': ('reserva_agua_24h', 'planta_electrica')}),
    )

@admin.register(SoporteDocumental)
class SoporteDocumentalAdmin(admin.ModelAdmin):
    list_display = ('tipo_documento', 'sede', 'version', 'es_vigente', 'fecha_vencimiento')
    list_filter = ('es_vigente', 'tipo_documento__categoria')
    readonly_fields = ('version', 'fecha_carga')